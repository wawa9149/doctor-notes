# RAG 서비스 전용 Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# pip 업그레이드 및 타임아웃 설정
RUN pip install --upgrade pip

# RAG 서비스 requirements 복사 및 설치
COPY app/rag/requirements.txt ./requirements-rag.txt

# 큰 패키지들을 먼저 설치 (캐싱 활용, 타임아웃 600초)
# 1. 기본 데이터 처리 패키지
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    numpy>=1.26.4 \
    pandas>=2.2.3

# 2. PyTorch와 transformers 종속성 먼저 설치 (sentence-transformers의 주요 종속성)
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    torch>=2.3.1 \
    torchvision \
    torchaudio \
    transformers>=4.38.0 \
    huggingface-hub>=0.19.4

# 3. sentence-transformers 설치 (종속성이 이미 설치되어 더 빠름)
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    sentence-transformers>=3.2.1

# 4. LangChain 관련 큰 패키지들 (의존성이 많음)
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    langchain>=0.3.21 \
    langchain-community>=0.3.20 \
    langchain-huggingface>=0.3.1

# 5. ChromaDB 설치 (벡터 DB)
RUN pip install --no-cache-dir --timeout=600 --retries=5 \
    chromadb>=1.0.9

# 6. 나머지 패키지 설치 (타임아웃 600초)
RUN pip install --no-cache-dir --timeout=600 --retries=5 -r requirements-rag.txt

# RAG 서비스 코드 복사
COPY app/rag ./app/rag

# 포트 노출
EXPOSE 8001

# RAG 서비스 실행
CMD ["python", "-m", "uvicorn", "app.rag.main:app", "--host", "0.0.0.0", "--port", "8001"]
